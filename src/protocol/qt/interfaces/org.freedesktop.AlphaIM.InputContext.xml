<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.freedesktop.AlphaIM.InputContext">
    <method name="ProcessKeyEvent">
      <arg name="ic" direction="in" type="u"/>
      <arg name="keyval" direction="in" type="u"/>
      <arg name="keycode" direction="in" type="u"/>
      <arg name="state" direction="in" type="u"/>
      <arg name="handled" direction="out" type="i"/>
    </method>
    <method name="SetCursorLocation">
      <arg name="ic" direction="in" type="u"/>
      <arg name="x" direction="in" type="i"/>
      <arg name="y" direction="in" type="i"/>
      <arg name="w" direction="in" type="i"/>
      <arg name="h" direction="in" type="i"/>
      <arg name="result" direction="out" type="i"/>
    </method>
    <method name="FocusIn">
     <arg name="id" direction="in" type="u"/>
     <arg name="result" direction="out" type="i"/>
   </method>
    <method name="FocusOut"><arg name="ic" direction="in" type="u"/><arg name="result" direction="out" type="i"/></method>
    <method name="Reset"><arg name="ic" direction="in" type="u"/><arg name="result" direction="out" type="i"/></method>
    <method name="Enable"><arg name="ic" direction="in" type="u"/><arg name="result" direction="out" type="i"/></method>
    <method name="Disable"><arg name="ic" direction="in" type="u"/><arg name="result" direction="out" type="i"/></method>
    <method name="IsEnabled">
      <arg name="ic" direction="in" type="u"/>
      <arg name="enable" direction="out" type="b"/>
    </method>
    <method name="SetCapabilities">
      <arg name="ic" direction="in" type="u"/>
      <arg name="caps" direction="in" type="u"/>
      <arg name="result" direction="out" type="i"/>
    </method>
    <method name="PropertyActivate">
      <arg name="ic" direction="in" type="u"/>
      <arg name="name" direction="in" type="s"/>
      <arg name="state" direction="in" type="i"/>
      <arg name="result" direction="out" type="i"/>
    </method>
    <method name="SetSurroundingText">
      <arg name="ic" direction="in" type="u"/>
      <arg name="text" direction="in" type="v"/>
      <arg name="cursor_pos" direction="in" type="u"/>
      <arg name="anchor_pos" direction="in" type="u"/>
      <arg name="result" direction="out" type="i"/>
    </method>
    <method name="Destroy"><arg name="ic" direction="in" type="u"/><arg name="result" direction="out" type="i"/></method>
    <signal name="CommitText">
      <arg name="text" type="s"/>
    </signal>
  </interface>
</node>
